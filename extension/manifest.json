{
  "manifest_version": 3,
  "name": "APS Watch Together",
  "short_name": "APS Watch",
  "version": "1.3.0",
  "description": "Private synchronized watch rooms with flexible video, audio and watch-only participation modes.",
  "minimum_chrome_version": "141",
  "permissions": [
    "storage",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.in/*",
    "https://*.amazon.com.au/*",
    "https://*.zee5.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open APS Watch Together",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*"
      ],
      "js": [
        "netflix-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com.au/*",
        "https://*.zee5.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
